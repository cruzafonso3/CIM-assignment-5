   "source": [
    "# --- Demonstração 1.1.i ---\n",
    "CAR_FOLDER = 'video sequences/sequence of still images - car'\n",
    "VIDEO_PATH = 'video sequences/input.mp4'\n",
    "\n",
    "# Sequência de imagens BMP (pasta car)\n",
    "if os.path.isdir(CAR_FOLDER):\n",
    "    frames_y_car, frames_full_car = load_image_sequence(CAR_FOLDER, extension='.bmp', color_space='YCrCb')\n",
    "    print(f\"Número de frames carregados : {len(frames_y_car)}\")\n",
    "    print(f\"Resolução (H×W)             : {frames_y_car[0].shape}\")\n",
    "    print(f\"Dtype                       : {frames_y_car[0].dtype}\")\n",
    "    print(f\"Gama de valores (min/max)   : {frames_y_car[0].min()} / {frames_y_car[0].max()}\")\n",
    "    display_frames(frames_y_car, title='Car sequence — canal Y (YCrCb)', n_show=5)\n",
    "\n",
    "    # Comparação dos canais Y para diferentes espaços de cor\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(13, 4))\n",
    "    for ax, cs in zip(axes, ['YCrCb', 'YUV', 'LAB']):\n",
    "        fy, _ = load_image_sequence(CAR_FOLDER, extension='.bmp', color_space=cs)\n",
    "        ax.imshow(fy[0], cmap='gray')\n",
    "        ax.set_title(f'Canal Y — {cs}')\n",
    "        ax.axis('off')\n",
    "    plt.suptitle('Canal de luminância em diferentes espaços de cor (frame 1)')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # Histograma do canal Y\n",
    "    fig, ax = plt.subplots(figsize=(8, 3))\n",
    "    for idx_f, f in enumerate(frames_y_car):\n",
    "        ax.hist(f.flatten(), bins=64, alpha=0.4, label=f'Frame {idx_f+1}')\n",
    "    ax.set_xlabel('Valor de pixel (Y)')\n",
    "    ax.set_ylabel('Contagem')\n",
    "    ax.set_title('Histograma do canal Y — sequência car')\n",
    "    ax.legend(fontsize=7, ncol=4)\n",
    "    plt.tight_layout(); plt.show()\n",
    "else:\n",
    "    print(f\"[INFO] Pasta '{CAR_FOLDER}' não encontrada.\")\n",
    "\n",
    "# Vídeo MP4 (usando a função da professora)\n",
    "if os.path.isfile(VIDEO_PATH):\n",
    "    frames_video = crop_frames_to_multiples_of_8(VIDEO_PATH)\n",
    "    print(f\"[VIDEO] Extraídos {len(frames_video)} frames | resolução: {frames_video[0].shape}\")\n",
    "    display_frames(frames_video, title='input.mp4 — canal Y', n_show=5)\n",
    "else:\n",
    "    print(f\"[INFO] Vídeo '{VIDEO_PATH}' não encontrado.\")\n"
   ]
