      "\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[31]\u001b[39m\u001b[32m, line 111\u001b[39m, in \u001b[36mencode_sequence\u001b[39m\u001b[34m(frames_y, gop_N, gop_M, block_size, search_range, quant_scale, output_dir)\u001b[39m\n\u001b[32m    108\u001b[39m \u001b[38;5;66;03m# Backward ainda não decodificado → usa frame original como proxy\u001b[39;00m\n\u001b[32m    109\u001b[39m ref_bwd = frames_y[bwd_idx]\n\u001b[32m--> \u001b[39m\u001b[32m111\u001b[39m mv_list, residual = \u001b[43mcompute_motion_and_residual\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m    112\u001b[39m \u001b[43m    \u001b[49m\u001b[43mframe\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m[\u001b[49m\u001b[43mref_fwd\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mref_bwd\u001b[49m\u001b[43m]\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mmode\u001b[49m\u001b[43m=\u001b[49m\u001b[33;43m'\u001b[39;49m\u001b[33;43mB\u001b[39;49m\u001b[33;43m'\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[32m    113\u001b[39m \u001b[43m    \u001b[49m\u001b[43msearch_range\u001b[49m\u001b[43m=\u001b[49m\u001b[43msearch_range\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mblock_size\u001b[49m\u001b[43m=\u001b[49m\u001b[43mblock_size\u001b[49m\n\u001b[32m    114\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    115\u001b[39m dct_r  = apply_dct_to_frame(residual.astype(np.float64))\n\u001b[32m    116\u001b[39m q_r    = quantize_frame(dct_r, mode=\u001b[33m'\u001b[39m\u001b[33mB\u001b[39m\u001b[33m'\u001b[39m, scale=quant_scale)\n",
      "\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[21]\u001b[39m\u001b[32m, line 84\u001b[39m, in \u001b[36mcompute_motion_and_residual\u001b[39m\u001b[34m(anchor_frame, ref_frames, mode, pixel_accuracy, search_range, block_size, min_block_size)\u001b[39m\n\u001b[32m     82\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m \u001b[32m0\u001b[39m <= ri < H - mb + \u001b[32m1\u001b[39m \u001b[38;5;129;01mand\u001b[39;00m \u001b[32m0\u001b[39m <= rj < W - mb + \u001b[32m1\u001b[39m:\n\u001b[32m     83\u001b[39m     cand = ref_fwd[ri:ri+mb, rj:rj+mb]\n\u001b[32m---> \u001b[39m\u001b[32m84\u001b[39m     err  = \u001b[38;5;28mfloat\u001b[39m(\u001b[43mnp\u001b[49m\u001b[43m.\u001b[49m\u001b[43mmean\u001b[49m\u001b[43m(\u001b[49m\u001b[43m(\u001b[49m\u001b[43mblk_anchor\u001b[49m\u001b[43m \u001b[49m\u001b[43m-\u001b[49m\u001b[43m \u001b[49m\u001b[43mcand\u001b[49m\u001b[43m)\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43m*\u001b[49m\u001b[43m \u001b[49m\u001b[32;43m2\u001b[39;49m\u001b[43m)\u001b[49m)\n\u001b[32m     85\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m err < best_mse_fwd:\n\u001b[32m     86\u001b[39m         best_mse_fwd = err\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/.local/lib/python3.12/site-packages/numpy/_core/fromnumeric.py:3694\u001b[39m, in \u001b[36m_mean_dispatcher\u001b[39m\u001b[34m(a, axis, dtype, out, keepdims, where)\u001b[39m\n\u001b[32m   3679\u001b[39m \u001b[38;5;250m    \u001b[39m\u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m   3680\u001b[39m \u001b[33;03m    Round an array to the given number of decimals.\u001b[39;00m\n\u001b[32m   3681\u001b[39m \n\u001b[32m   (...)\u001b[39m\u001b[32m   3689\u001b[39m \n\u001b[32m   3690\u001b[39m \u001b[33;03m    \"\"\"\u001b[39;00m\n\u001b[32m   3691\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m _wrapfunc(a, \u001b[33m'\u001b[39m\u001b[33mround\u001b[39m\u001b[33m'\u001b[39m, decimals=decimals, out=out)\n\u001b[32m-> \u001b[39m\u001b[32m3694\u001b[39m \u001b[38;5;28;01mdef\u001b[39;00m \u001b[34m_mean_dispatcher\u001b[39m(a, axis=\u001b[38;5;28;01mNone\u001b[39;00m, dtype=\u001b[38;5;28;01mNone\u001b[39;00m, out=\u001b[38;5;28;01mNone\u001b[39;00m, keepdims=\u001b[38;5;28;01mNone\u001b[39;00m, *,\n\u001b[32m   3695\u001b[39m                      where=\u001b[38;5;28;01mNone\u001b[39;00m):\n\u001b[32m   3696\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m (a, where, out)\n\u001b[32m   3699\u001b[39m \u001b[38;5;129m@array_function_dispatch\u001b[39m(_mean_dispatcher)\n\u001b[32m   3700\u001b[39m \u001b[38;5;28;01mdef\u001b[39;00m \u001b[34mmean\u001b[39m(a, axis=\u001b[38;5;28;01mNone\u001b[39;00m, dtype=\u001b[38;5;28;01mNone\u001b[39;00m, out=\u001b[38;5;28;01mNone\u001b[39;00m, keepdims=np._NoValue, *,\n\u001b[32m   3701\u001b[39m          where=np._NoValue):\n",
