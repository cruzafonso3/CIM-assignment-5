    "# --- Demonstração 1.1.ii–iv: estimação de MV entre frames consecutivos ---\n",
    "\n",
    "if 'frames_y_car' in dir() and len(frames_y_car) >= 3:\n",
    "    f0 = frames_y_car[0]\n",
    "    f1 = frames_y_car[1]\n",
    "    f2 = frames_y_car[2]\n",
    "\n",
    "    # --- Modo P (1.1.ii) — função original da professora ---\n",
    "    mv_simple = block_matching(f0, f1, block_size=16, search_range=8)\n",
    "    print(f\"[block_matching — professora] Grid de MVs: {mv_simple.shape}\")\n",
    "    print(f\"  MV[0,0]={mv_simple[0,0]}  MV[1,1]={mv_simple[1,1]}  MV[2,2]={mv_simple[2,2]}\")\n",
    "    magnitudes = np.sqrt(mv_simple[...,0]**2 + mv_simple[...,1]**2)\n",
    "    print(f\"  Magnitude média dos MVs: {magnitudes.mean():.2f} px | máx: {magnitudes.max():.2f} px\")\n",
    "\n",
    "    # --- Modo P extendido (1.1.ii/iii) ---\n",
    "    mv_list_P, residual_P = compute_motion_and_residual(\n",
    "        f1, [f0], mode='P', search_range=8, block_size=16)\n",
    "    print(f\"\\n[compute_motion_and_residual] Modo P | {len(mv_list_P)} MVs\")\n",
    "    print(f\"  Residual — média: {np.mean(np.abs(residual_P)):.2f} | máx: {np.max(np.abs(residual_P))}\")\n",
    "\n",
    "    # --- Modo B (1.1.iii) ---\n",
    "    mv_list_B, residual_B = compute_motion_and_residual(\n",
    "        f1, [f0, f2], mode='B', search_range=8, block_size=16)\n",
    "    print(f\"[compute_motion_and_residual] Modo B | {len(mv_list_B)} MVs\")\n",
    "    print(f\"  Residual B — média: {np.mean(np.abs(residual_B)):.2f} | máx: {np.max(np.abs(residual_B))}\")\n",
    "\n",
    "    # --- Visualização MVs modo P (1.1.iv) ---\n",
    "    plot_motion_vectors(f1, mv_list_P, mode='P', block_size=16,\n",
    "                        title='Vetores de movimento — car frame 2 (modo P, MB=16)')\n",
    "\n",
    "    # --- Visualização MVs modo B (1.1.iv) ---\n",
    "    plot_motion_vectors(f1, mv_list_B, mode='B', block_size=16,\n",
    "                        title='Vetores de movimento — car frame 2 (modo B, MB=16)')\n",
    "\n",
    "    # --- Heatmap da magnitude dos MVs ---\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "    im0 = axes[0].imshow(magnitudes, cmap='hot', interpolation='nearest')\n",
    "    axes[0].set_title('Magnitude dos MVs (block_matching, MB=16)')\n",
    "    plt.colorbar(im0, ax=axes[0], label='pixels')\n",
    "    # Residual P vs B\n",
    "    axes[1].plot([np.mean(np.abs(residual_P)), np.mean(np.abs(residual_B))],\n",
    "                 'o-', color='steelblue', markersize=10)\n",
    "    axes[1].set_xticks([0,1]); axes[1].set_xticklabels(['Modo P', 'Modo B'])\n",
    "    axes[1].set_ylabel('Erro residual médio (|pixel|)')\n",
    "    axes[1].set_title('Comparação de residual: modo P vs modo B')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # --- Frame original / predito / residual ---\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "    axes[0].imshow(f0,                   cmap='gray'); axes[0].set_title('Referência (frame 1)')\n",
    "    axes[1].imshow(f1,                   cmap='gray'); axes[1].set_title('Alvo (frame 2)')\n",
    "    axes[2].imshow(np.abs(residual_P),   cmap='hot');  axes[2].set_title('Residual |frame2 − predito| (modo P)')\n",
    "    for ax in axes: ax.axis('off')\n",
    "    plt.suptitle('Estimação de movimento — modo P (MB=16, SR=8)')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # --- Efeito do tamanho do MB no residual (1.1.iii) ---\n",
    "    print(\"\\n--- Efeito do tamanho do MB no residual médio ---\")\n",
    "    mb_sizes   = [16, 8, 4]\n",
    "    res_means  = []\n",
    "    for mb in mb_sizes:\n",
    "        _, res = compute_motion_and_residual(f1, [f0], mode='P', search_range=8, block_size=mb)\n",
    "        mean_res = np.mean(np.abs(res))\n",
    "        res_means.append(mean_res)\n",
    "        print(f\"  MB={mb:2d}×{mb:2d} | residual médio: {mean_res:.4f}\")\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(6, 4))\n",
    "    ax.bar([str(m) for m in mb_sizes], res_means, color=['steelblue','tomato','gold'], edgecolor='black')\n",
    "    ax.set_xlabel('Tamanho do macrobloco (pixels)')\n",
    "    ax.set_ylabel('Erro residual médio (|pixel|)')\n",
    "    ax.set_title('Impacto do tamanho do MB no residual (modo P)')\n",
    "    for i, v in enumerate(res_means):\n",
    "        ax.text(i, v + 0.1, f'{v:.2f}', ha='center', fontsize=10)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "else:\n",
    "    print(\"[INFO] frames_y_car não disponível ou < 3 frames.\")\n"
   ]
