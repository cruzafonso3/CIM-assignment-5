   "source": [
    "# =============================================================\n",
    "# EXPERIMENTO — Vídeo MP4 (input.mp4)\n",
    "# Usa a função crop_frames_to_multiples_of_8 da professora\n",
    "# =============================================================\n",
    "\n",
    "VIDEO_PATH = 'video sequences/input.mp4'\n",
    "\n",
    "if os.path.isfile(VIDEO_PATH):\n",
    "    print(\"A extrair frames do vídeo (pode demorar)...\")\n",
    "    frames_video = crop_frames_to_multiples_of_8(VIDEO_PATH)\n",
    "    # Limitar a 30 frames para demo rápida\n",
    "    frames_demo = frames_video[:30]\n",
    "    print(f\"Usando {len(frames_demo)} frames para o experimento.\")\n",
    "\n",
    "    _, bits_video = encode_sequence(\n",
    "        frames_demo,\n",
    "        gop_N=9, gop_M=3,\n",
    "        block_size=16, search_range=8,\n",
    "        quant_scale=1,\n",
    "        output_dir='compressed'\n",
    "    )\n",
    "    print(f\"\\nVídeo input.mp4 (30 frames) | Bits estimados: {bits_video:,}\")\n",
    "else:\n",
    "    print(f\"[INFO] Vídeo '{VIDEO_PATH}' não encontrado.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "summary-header",
   "metadata": {},
   "source": [
    "---\n",
    "## Resumo dos Ficheiros Gerados\n",
    "\n",
    "Os ficheiros comprimidos (dados DCT quantizados + vetores de movimento) são guardados na pasta `compressed/` em formato `.npz` (NumPy compressed arrays), um por cada configuração testada.\n",
    "\n",
    "Cada ficheiro `.npz` contém os seguintes arrays nomeados:\n",
    "\n",
    "| Array | Conteúdo |\n",
    "|---|---|\n",
    "| `q_frames` | Coeficientes DCT quantizados de cada frame |\n",
    "| `frame_types` | Tipo de cada frame (`'I'`, `'P'`, `'B'`) |\n",
    "| `mv_array` | Vetores de movimento por frame (lista de tuplos) |\n",
    "| `gop_seq` | Sequência GOP completa |\n",
    "| `ref_idxs` / `bwd_idxs` | Índices de referência forward/backward |\n",
    "| `params_*` | Parâmetros usados na codificação (N, M, block_size, QS, SR) |\n",
    "\n",
    "Estes ficheiros serão lidos na **Parte 2** (decoder + avaliação PSNR/SSIM).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "list-outputs",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Lista os ficheiros .npz gerados e mostra os seus conteúdos\n",
    "if os.path.isdir('compressed'):\n",
    "    files = sorted([f for f in os.listdir('compressed') if f.endswith('.npz')])\n",
    "    print(f\"Ficheiros .npz em 'compressed/' ({len(files)} total):\\n\")\n",
    "    print(f\"{'Ficheiro':<55} {'Tamanho':>10}  {'Frames':>7}  {'Arrays guardados'}\")\n",
    "    print(\"-\" * 100)\n",
    "    for fname in files:\n",
    "        fpath    = os.path.join('compressed', fname)\n",
    "        size_kb  = os.path.getsize(fpath) / 1024\n",
    "        data     = np.load(fpath, allow_pickle=True)\n",
    "        n_frames = len(data['frame_types'])\n",
    "        keys     = ', '.join(data.files)\n",
    "        print(f\"  {fname:<53} {size_kb:>9.1f} KB  {n_frames:>7}  {keys}\")\n",
    "        # Distribuição de tipos de frame\n",
    "        ftypes = data['frame_types']\n",
    "        counts = {t: int(np.sum(ftypes == t)) for t in ['I','P','B']}\n",
    "        print(f\"    └─ Tipos: I={counts['I']}  P={counts['P']}  B={counts['B']}  \"\n",
    "              f\"| QS={data['params_quant_scale']:.0f}  MB={data['params_block_size']}  \"\n",
    "              f\"N={data['params_N']}  M={data['params_M']}\")\n",
    "else:\n",
    "    print(\"Pasta 'compressed/' ainda não existe. Execute os experimentos acima.\")\n"
   ]
  }
 ],
